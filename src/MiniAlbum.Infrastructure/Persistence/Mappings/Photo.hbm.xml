<?xml version="1.0" encoding="utf-8" ?>

<hibernate-mapping
	xmlns="urn:nhibernate-mapping-2.2"
	assembly="MiniAlbum.Domain"
	namespace="MiniAlbum.Domain.Entities">

	<class name="Photo" table="Photos">

		<id name="Id" column="Id">
			<generator class="native" />
		</id>

		<property
			name="Title"
			column ="Title"
			not-null="true"
			length="200" />

		<property
			name="Description"
			column="Description"
			not-null="false"
			length="1000" />

		<property
			name="FileName"
			column="Filename"
			not-null="true"
			length="500" />

		<many-to-one
			name="Album"
			class="Album"
			column="AlbumId"
			not-null="true" />

		<bag name="Comments"
			 inverse="true"
			 cascade="all-delete-orphan">

			<key column="PhotoId" />

			<one-to-many class="Comment" />
			
		</bag>
		
		</class>
		
</hibernate-mapping>
